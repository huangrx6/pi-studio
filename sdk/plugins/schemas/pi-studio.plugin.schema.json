{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-studio.dev/schemas/pi-studio.plugin.schema.json",
  "title": "Pi Studio Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "name", "version", "provides"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1 },
    "kind": { "const": "plugin" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "publisher": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "icon": { "type": "string", "maxLength": 260 },
    "category": { "type": "string", "maxLength": 64 },
    "homepage": { "type": "string", "maxLength": 500 },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["name", "transport"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 64 },
              "transport": { "enum": ["stdio", "http"] },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
              "url": { "type": "string" },
              "description": { "type": "string", "maxLength": 1200 },
              "cwd": { "type": "string" },
              "exposure": { "enum": ["direct", "deferred", "hidden"] },
              "envKeys": { "type": "array", "items": { "type": "string" }, "maxItems": 64 }
            }
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 260 } }
          }
        },
        "cli": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "name": { "type": "string", "maxLength": 120 },
              "bin": { "type": "string", "maxLength": 260 },
              "command": { "type": "string", "maxLength": 260 },
              "description": { "type": "string", "maxLength": 1200 },
              "pathEnv": { "type": "boolean" },
              "version": { "type": "string", "maxLength": 64 },
              "optional": { "type": "boolean" },
              "envKeys": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
              "platform": { "type": "array", "items": { "type": "string" }, "maxItems": 16 },
              "commands": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "summary": { "type": "string", "maxLength": 200 },
                    "example": { "type": "string", "maxLength": 400 }
                  }
                }
              }
            }
          }
        },
        "extension": {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 260 } }
        }
      }
    }
  }
}
