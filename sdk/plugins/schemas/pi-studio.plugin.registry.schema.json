{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.studio/schemas/pi-studio.plugin.registry.schema.json",
  "title": "Pi Studio Plugin Registry",
  "description": "A static, HTTPS-hostable or local plugin registry for Pi Studio marketplace discovery.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "maxLength": 120 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "plugins": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "pluginId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "maxLength": 2000,
      "format": "uri",
      "pattern": "^https://"
    },
    "providesSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 100 },
            { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 100 }
          ]
        },
        "skills": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 100 },
            { "type": "array", "items": { "type": "string", "maxLength": 120 }, "maxItems": 100 }
          ]
        },
        "cli": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 100 },
            { "type": "array", "items": { "type": "string", "maxLength": 120 }, "maxItems": 100 }
          ]
        },
        "extension": { "type": "boolean" }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "packagePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Relative directory under the registry file parent for local/official packages."
        },
        "download": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "anyOf": [
        { "required": ["packagePath"] },
        { "required": ["download"] }
      ]
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "publisher", "versions"],
      "properties": {
        "id": { "$ref": "#/$defs/pluginId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 80 },
        "summary": { "type": "string", "maxLength": 280 },
        "description": { "type": "string", "maxLength": 4000 },
        "category": { "type": "string", "maxLength": 64 },
        "icon": { "type": "string", "maxLength": 2000 },
        "homepage": { "type": "string", "maxLength": 2000 },
        "repository": { "type": "string", "maxLength": 2000 },
        "keywords": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 40 }
        },
        "provides": { "$ref": "#/$defs/providesSummary" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/version" }
        }
      }
    }
  }
}
