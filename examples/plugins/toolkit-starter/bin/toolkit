#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "--version" || "${1:-}" == "-v" ]]; then
  echo "toolkit 0.1.0"
  exit 0
fi
if [[ "${1:-}" == "hello" ]]; then
  echo "hello from toolkit-starter plugin"
  exit 0
fi
echo "toolkit — example CLI from Pi Studio plugin"
echo "usage: toolkit hello | toolkit --version"
