{
  "$schema": "../../sdk/extensions/schemas/pi-studio.extension.schema.json",
  "format": 1,
  "id": "pi-quota-status",
  "name": "额度状态",
  "version": "0.7.0",
  "description": "按当前会话模型来源保存的接口和字段显示额度。",
  "author": "huangrx6",
  "publisher": "Pi Studio",
  "license": "MIT",
  "repository": "https://github.com/huangrx6/pi-studio",
  "engines": {
    "piStudio": ">=0.0.13 <0.2.0"
  },
  "permissions": [
    "ui.panels"
  ],
  "contributes": {
    "panels": [
      {
        "id": "quota-detail",
        "title": "额度状态",
        "slot": "status.detail",
        "icon": "gauge",
        "size": "regular",
        "priority": 20,
        "content": []
      },
      {
        "id": "quota-chip",
        "title": "额度状态",
        "slot": "status.chip",
        "icon": "gauge",
        "size": "compact",
        "priority": 20,
        "details": "quota-detail",
        "content": []
      }
    ]
  }
}
