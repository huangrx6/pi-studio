{
  "$schema": "../../schemas/pi-studio.extension.schema.json",
  "format": 1,
  "id": "pi-project-scripts",
  "name": "项目脚本速查",
  "version": "1.0.0",
  "description": "查看当前工作区的项目脚本，按包管理器生成并复制运行命令。",
  "author": "huangrx6",
  "publisher": "Pi Studio",
  "license": "MIT",
  "repository": "https://github.com/huangrx6/pi-studio",
  "engines": { "piStudio": ">=0.0.28 <0.2.0" },
  "keywords": ["workspace", "scripts", "official"],
  "readme": "README.md",
  "permissions": ["ui.panels", "ui.data"],
  "runtime": { "durableEntry": "extension.mjs" },
  "contributes": {
    "dataSources": [
      { "id": "scripts", "title": "项目脚本" },
      { "id": "summary", "title": "脚本数量" }
    ],
    "panels": [
      {
        "id": "script-list", "title": "项目脚本速查", "description": "浏览工作区中的脚本及运行命令。",
        "slot": "conversation.detail", "size": "regular", "priority": 20,
        "content": [{ "kind": "dataView", "sourceId": "user:pi-project-scripts/scripts" }]
      },
      {
        "id": "scripts-chip", "title": "项目脚本", "description": "打开此工作区的脚本清单。",
        "slot": "status.chip", "size": "compact", "priority": 20, "icon": "terminal", "details": "script-list",
        "content": [{ "kind": "dataView", "sourceId": "user:pi-project-scripts/summary", "fallback": [{ "kind": "text", "text": "正在读取项目脚本" }] }]
      }
    ]
  }
}
