{
  "name": "pi-studio",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "description": "Pi Studio — a native macOS desktop workspace for the Pi coding agent.",
  "author": "huangrx6",
  "license": "MIT",
  "homepage": "https://huangrx6.github.io/pi-studio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangrx6/pi-studio.git"
  },
  "bugs": {
    "url": "https://github.com/huangrx6/pi-studio/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.28.5",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"pnpm run web\" \"wait-on tcp:5180 && cross-env PI_STUDIO_DEV=1 node scripts/launch.mjs\"",
    "web": "vite --host 127.0.0.1 --port 5180",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "node scripts/launch.mjs",
    "test": "node --test scripts/*.test.cjs scripts/*.test.mjs",
    "dist": "pnpm run build && electron-builder --mac --arm64 --x64 --publish never"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "simple-icons": "16.36.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "45.0.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "1.61.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.pi.studio",
    "productName": "Pi Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**",
      "electron/**",
      "web-dist/**",
      "web/src/styles/palette.css",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "artifactName": "Pi-Studio-${version}-${arch}.${ext}",
      "target": [
        "dmg"
      ]
    }
  }
}
