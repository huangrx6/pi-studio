{
  "name": "pi-studio",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "description": "Pi Studio — a native desktop workspace built on Pi Durable.",
  "author": "huangrx6",
  "license": "MIT",
  "homepage": "https://huangrx6.github.io/pi-studio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangrx6/pi-studio.git"
  },
  "bugs": {
    "url": "https://github.com/huangrx6/pi-studio/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.28.5",
  "main": "electron/main.cjs",
  "bin": {
    "pi-studio-extension": "tools/cli/pi-studio-extension.mjs"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm run web\" \"wait-on tcp:5180 && cross-env PI_STUDIO_DEV=1 node tools/launch.mjs\"",
    "web": "vite --host 127.0.0.1 --port 5180",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "extension": "node tools/cli/pi-studio-extension.mjs",
    "extension:official": "node tools/cli/pi-studio-extension.mjs seal-official extensions",
    "extension:schema": "node tools/cli/generate-extension-schema.mjs",
    "release:cert": "bash tools/release/create-self-signed-macos-certificate.sh",
    "release:dist": "bash tools/release/build-signed-macos.sh",
    "qa:memory": "node tools/qa/qa-memory-smoke.mjs",
    "start": "node tools/launch.mjs",
    "test": "node --test tests/electron/*.test.cjs tests/web/*.test.mjs tests/integration/*.test.cjs tests/integration/*.test.mjs",
    "dist": "pnpm run build && electron-builder --mac --arm64 --x64 --publish never"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "simple-icons": "16.36.0",
    "yaml": "2.9.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "45.0.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "1.61.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.pi.studio",
    "productName": "Pi Studio",
    "afterPack": "tools/release/electron-builder-after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**",
      "electron/**",
      "web-dist/**",
      "web/src/styles/palette.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extensions",
        "to": "official-extensions"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "artifactName": "Pi-Studio-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "huangrx6",
      "repo": "pi-studio"
    }
  }
}
