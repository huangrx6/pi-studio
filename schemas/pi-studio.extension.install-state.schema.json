{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.studio/schemas/pi-studio.extension.install-state.schema.json",
  "title": "Pi Studio Extension Install State",
  "description": "Private installer state. Code, state, and extension data use separate roots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "scope",
    "dataPath",
    "activeHistoryIndex",
    "history",
    "installedAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "scope": {
      "enum": [
        "user",
        "project"
      ]
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "dataPath": {
      "type": "string",
      "minLength": 1
    },
    "activeHistoryIndex": {
      "type": "integer",
      "minimum": 0
    },
    "installedAt": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAt": {
      "type": "integer",
      "minimum": 0
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/historyEntry"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "permission": {
      "enum": [
        "agent.tools",
        "agent.sections",
        "agent.hooks",
        "agent.tasks",
        "ui.commands",
        "ui.panels",
        "ui.settings",
        "network"
      ]
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "source",
        "sourceKind",
        "publisher",
        "permissions",
        "requires",
        "trusted",
        "codePath",
        "activatedAt"
      ],
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceKind": {
          "enum": [
            "local-directory",
            "archive",
            "https",
            "github-release",
            "github-commit",
            "registry"
          ]
        },
        "resolvedRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^(?:builtin|user|project):[a-z0-9][a-z0-9._-]{1,63}$"
          }
        },
        "trusted": {
          "type": "boolean"
        },
        "codePath": {
          "type": "string",
          "minLength": 1
        },
        "activatedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
