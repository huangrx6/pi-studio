{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.studio/schemas/pi-studio.skill.registry.schema.json",
  "title": "Pi Studio Skill Registry",
  "description": "A static catalog of integrity-checked Agent Skills ZIP packages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skills"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "skills": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "download": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "An HTTPS URL or a path relative to this registry JSON."
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "version",
        "download",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "invocation": {
          "enum": [
            "automatic",
            "explicit"
          ]
        },
        "download": {
          "$ref": "#/$defs/download"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "resourceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  }
}
